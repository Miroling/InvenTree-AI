{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "replicaCount", "publicUrl", "inventreeUrl", "auth", "existingSecret", "ingress", "networkPolicy"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["reference", "pullPolicy"],
      "properties": {
        "reference": {"type": "string", "minLength": 1},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "replicaCount": {"type": "integer", "const": 1},
    "publicUrl": {"type": "string", "pattern": "^https://[^/?#]+/mcp$"},
    "inventreeUrl": {"type": "string", "pattern": "^https?://[^/?#]+(/[^?#]*)?$"},
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience"],
      "properties": {
        "audience": {"type": "string", "minLength": 1}
      }
    },
    "existingSecret": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
    "ingress": {
      "type": "object",
      "required": ["enabled", "className", "host", "tlsSecretName"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string", "minLength": 1},
        "host": {"type": "string"},
        "tlsSecretName": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"properties": {"host": {"minLength": 1}, "tlsSecretName": {"minLength": 1}}}
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "ingressNamespaceSelector", "ingressPodSelector"],
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressNamespaceSelector": {"type": "object", "minProperties": 1},
        "ingressPodSelector": {"type": "object", "minProperties": 1}
      }
    }
  }
}
